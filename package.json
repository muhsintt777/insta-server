{
  "name": "insta-server",
  "version": "1.4.1",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register -P tsconfig.json ./src/core/server.ts",
    "start": "node ./dist/core/server.js",
    "build": "tsc && tsc-alias",
    "format": "prettier --write './src/**/*.{ts,js,json,md}'",
    "test": "jest --config jest.config.json",
    "test:watch": "jest --watch --config jest.config.json",
    "bump:major": "node ./scripts/bumbUpVersion.js major",
    "bump:minor": "node ./scripts/bumbUpVersion.js minor",
    "bump:patch": "node ./scripts/bumbUpVersion.js patch"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.22.1",
    "mongoose-aggregate-paginate-v2": "^1.1.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "openmeteo": "^1.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.14",
    "@types/express": "4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.4.8",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.4",
    "mongodb-memory-server": "^10.1.3",
    "prettier": "3.3.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "brace-expansion": "^1.1.12",
    "form-data": "^4.0.4",
    "cookie": "^0.7.2"
  }
}
