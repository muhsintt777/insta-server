# Environment Variables Example
# Copy to .env and fill in secure values

SERVER_TYPE=DEV
PORT=4000
MONGO_URI=mongodb://localhost:27017/insta

ACCESS_TOKEN_KEY=replace_me_access_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_KEY=replace_me_refresh_secret
REFRESH_TOKEN_EXPIRY=7d
COOKIE_EXPIRY_IN_DAYS=1

STORAGE_BUCKET_REGION=us-east-1
STORAGE_BUCKET_ACC_KEY=YOUR_AWS_ACCESS_KEY_ID
STORAGE_BUCKET_SEC_KEY=YOUR_AWS_SECRET_ACCESS_KEY
STORAGE_BUCKET_NAME=your-bucket-name
